{
  "name": "daemonchat",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*",
    "packages/platform/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "db:push": "supabase db push",
    "db:push:url": "supabase db push --db-url \"${SUPABASE_DB_URL}\"",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "loadtest:chat": "bun --cwd apps/web run loadtest:chat",
    "loadtest:claim": "bun --cwd apps/worker run loadtest:claim"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.8",
    "turbo": "^2.8.13",
    "typescript": "^5.5.0"
  }
}
